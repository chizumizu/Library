<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="container">
        <h1 class="site-heading">books lib</h1>
        <!-- Top Left Option for Fuzzy Search -->
        <div class="search-container">
            <input 
                type="text" 
                id="fuzzySearch" 
                class="search-input" 
                placeholder="Fuzzy search by name, tag..." 
                autocomplete="off"
            />
        </div>

        <!-- Linear tab bar containing category tags (collapsible with ⋯ on mobile) -->
        <div class="tab-bar-wrap">
            <nav class="tab-bar" id="tabBar">
                <button class="tab-btn active" data-tag="all">all</button>
                <% if (tags && tags.length) { %>
                    <% tags.forEach(function(tag) { %>
                        <button class="tab-btn" data-tag="<%= tag.toLowerCase() %>"><%= tag %></button>
                    <% }); %>
                <% } %>
            </nav>
            <button type="button" class="tab-expand-btn" id="tabExpand" aria-controls="tabBar" aria-expanded="false" hidden>⋯</button>
        </div>

        <!-- Book display list table - no separate tag column, badges are on right side of name -->
        <table class="book-table">
            <thead>
                <tr>
                    <th class="col-sr">Sr. No.</th>
                    <th class="col-name">Name of Book</th>
                </tr>
            </thead>
            <tbody id="bookListBody">
                <% if (books && books.length) { %>
                    <% books.forEach(function(book, index) { 
                        const tags = Array.isArray(book.tags) ? book.tags.slice(0,3) : (book.tag ? [book.tag] : []);
                        const normalizedTags = tags.map(t => String(t).toLowerCase().trim()).filter(Boolean);
                        const tagsStr = normalizedTags.join(' ');
                        const hasLink = book.link && String(book.link).trim().length > 0;
                        const externalHref = hasLink ? String(book.link).trim() : '';
                        const previewHref = '/preview/' + encodeURIComponent(book.slug);
                        const downloadHref = '/download/' + encodeURIComponent(book.slug);
                        const displayName = book.title || book.slug;
                    %>
                        <tr 
                            class="book-row" 
                            data-index="<%= index + 1 %>" 
                            data-tags="<%= tagsStr %>" 
                            data-tag="<%= normalizedTags[0] || '' %>"
                            data-slug="<%= (book.slug || '').toLowerCase() %>"
                        >
                            <td class="col-sr"><%= index + 1 %></td>
                            <td class="col-name">
                                <div class="book-cell">
                                    <div class="book-main">
                                        <div class="book-title-row">
                                            <% if (hasLink) { %>
                                                <!-- Externally linked books: no preview, download straight from source -->
                                                <span class="book-title-plain"><%= displayName %></span>
                                                <a 
                                                    href="<%= externalHref %>" 
                                                    class="download-btn" 
                                                    download
                                                    target="_blank" 
                                                    rel="noopener noreferrer"
                                                    title="Download <%= displayName %> from source"
                                                    aria-label="Download <%= displayName %>"
                                                >
                                                    ⬇
                                                </a>
                                            <% } else { %>
                                                <a 
                                                    href="<%= previewHref %>" 
                                                    class="book-link" 
                                                    target="_blank" 
                                                    rel="noopener noreferrer"
                                                    title="Preview <%= displayName %> in new tab"
                                                >
                                                    <%= displayName %><span class="preview-icon"> ↗</span>
                                                </a>
                                                <a 
                                                    href="<%= downloadHref %>" 
                                                    class="download-btn" 
                                                    download="<%= book.slug %>.pdf" 
                                                    title="Download <%= book.slug %>.pdf"
                                                    aria-label="Download <%= book.slug %>.pdf"
                                                >
                                                    ⬇
                                                </a>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="badge-list">
                                        <% normalizedTags.forEach(function(t) { %>
                                            <span class="badge" data-tag="<%= t %>"><%= t %></span>
                                        <% }); %>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>

        <div id="noResults" class="no-results">No books found.</div>
    </div>

    <script>
        // Fuzzy search matching function for indexing, tag, and slug
        function fuzzyMatch(pattern, text) {
            if (!pattern) return true;
            if (!text) return false;
            pattern = pattern.toLowerCase().trim();
            text = text.toLowerCase().trim();
            if (text.includes(pattern)) return true;

            let pIdx = 0;
            let tIdx = 0;
            while (pIdx < pattern.length && tIdx < text.length) {
                if (pattern[pIdx] === text[tIdx]) {
                    pIdx++;
                }
                tIdx++;
            }
            return pIdx === pattern.length;
        }

        const searchInput = document.getElementById('fuzzySearch');
        const tabButtons = document.querySelectorAll('.tab-btn');
        const rows = document.querySelectorAll('.book-row');
        const noResults = document.getElementById('noResults');

        let activeTag = 'all';

        function filterList() {
            const query = (searchInput.value || '').trim();
            let visibleCount = 0;

            rows.forEach(function(row) {
                const rowIndex = row.dataset.index || '';
                const rowTags = row.dataset.tags || row.dataset.tag || '';
                const rowSlug = row.dataset.slug || '';

                // Category tab filtering - supports multiple tags
                const tagList = rowTags.split(' ').filter(Boolean);
                const matchesTag = (activeTag === 'all' || tagList.includes(activeTag));

                // Fuzzy search matching by indexing (Sr. No.) or tag (or slug)
                let matchesSearch = true;
                if (query) {
                    matchesSearch = fuzzyMatch(query, rowIndex) || 
                                    fuzzyMatch(query, rowTags) || 
                                    fuzzyMatch(query, rowSlug);
                }

                if (matchesTag && matchesSearch) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (noResults) {
                noResults.style.display = (visibleCount === 0) ? 'block' : 'none';
            }
        }

        // Fuzzy search event listener
        searchInput.addEventListener('input', filterList);

        // Linear tab bar event listeners
        tabButtons.forEach(function(btn) {
            btn.addEventListener('click', function() {
                tabButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                activeTag = this.dataset.tag;
                filterList();
            });
        });

        // Collapsible tab bar on mobile: show ⋯ when categories overflow
        const tabBar = document.getElementById('tabBar');
        const tabExpand = document.getElementById('tabExpand');
        const mobileQuery = window.matchMedia('(max-width: 560px)');

        function syncTabExpand() {
            if (!tabBar || !tabExpand) return;
            if (!mobileQuery.matches) {
                tabBar.classList.remove('is-expanded');
                tabExpand.hidden = true;
                tabExpand.textContent = '⋯';
                tabExpand.setAttribute('aria-expanded', 'false');
                return;
            }
            const expanded = tabBar.classList.contains('is-expanded');
            if (expanded) {
                tabExpand.hidden = false;
                tabExpand.textContent = '⌃';
                tabExpand.setAttribute('aria-expanded', 'true');
            } else {
                tabExpand.hidden = tabBar.scrollHeight <= tabBar.clientHeight + 2;
                tabExpand.textContent = '⋯';
                tabExpand.setAttribute('aria-expanded', 'false');
            }
        }

        if (tabExpand) {
            tabExpand.addEventListener('click', function() {
                tabBar.classList.toggle('is-expanded');
                syncTabExpand();
            });
        }
        window.addEventListener('resize', syncTabExpand);
        syncTabExpand();
    </script>
</body>
</html>
