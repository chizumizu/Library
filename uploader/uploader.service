[Unit]
Description=Books Library Uploader (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/uploader
Environment=UPLOADER_HOST=127.0.0.1
Environment=UPLOADER_PORT=8000
EnvironmentFile=%h/uploader/.env
ExecStart=%h/uploader/.venv/bin/uvicorn app.main:app --host ${UPLOADER_HOST} --port ${UPLOADER_PORT}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
